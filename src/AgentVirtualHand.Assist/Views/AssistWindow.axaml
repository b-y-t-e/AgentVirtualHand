<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentVirtualHand.Assist.ViewModels"
        x:Class="AgentVirtualHand.Assist.Views.AssistWindow"
        x:DataType="vm:AssistViewModel"
        Title="Support"
        Width="440" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="Cascadia Mono, Consolas, monospace">

  <StackPanel Margin="36" Spacing="18" VerticalAlignment="Center">

    <TextBlock Text="Support code" FontSize="13"
               Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />

    <Border Background="{DynamicResource Raised}" CornerRadius="8" Padding="18,16"
            IsVisible="{Binding HasCode}" Cursor="Hand"
            PointerPressed="OnCopyCode" ToolTip.Tip="Click to copy">
      <SelectableTextBlock Text="{Binding Code}"
                 FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{DynamicResource Text}" />
    </Border>

    <TextBlock Text="Starting…" IsVisible="{Binding !HasCode}" FontSize="13"
               Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />

    <Button x:Name="CopyButton" Classes="primary" Content="Copy code"
            IsVisible="{Binding HasCode}" HorizontalAlignment="Center"
            Click="OnCopyCode" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Ellipse Width="6" Height="6" Fill="{DynamicResource Ok}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding ConnectedText}" FontSize="12.5"
                 Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
    </StackPanel>

  </StackPanel>
</Window>
