<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentVirtualHand.ViewModels"
        x:Class="AgentVirtualHand.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AVH"
        Width="760" Height="680"
        MinWidth="660" MinHeight="540"
        Background="{DynamicResource Bg}"
        FontFamily="Cascadia Mono, Consolas, monospace"
        FontSize="13">

  <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" IsVisible="{Binding Lock.IsUnlocked}">

      <!-- Status bar: whose machine and who works on it now -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Height="44" Margin="24,0">
        <TextBlock Grid.Column="0" Text="avh" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="k" FontSize="12" Margin="12,0,0,0"
                   Text="{Binding MachineName}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                    HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Lock.LockCountdownText}" IsVisible="{Binding Lock.ShowLockCountdown}"
                     FontSize="12" Foreground="{Binding Lock.LockCountdownAccent}" VerticalAlignment="Center" />
          <Button Classes="chip" Content="{Binding Lock.AutoLockText}"
                  Foreground="{Binding Lock.AutoLockAccent}" Click="OnToggleAutoLock" />
        </StackPanel>
        <Ellipse Grid.Column="3" Width="6" Height="6" Fill="{Binding StatusAccent}"
                 VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0"
                   Foreground="{Binding StatusAccent}" VerticalAlignment="Center" />
      </Grid>
      <Border Grid.Row="0" Classes="sep" VerticalAlignment="Bottom" />

      <!-- Link stopped -->
      <StackPanel Grid.Row="1" Margin="24,26,24,24" Spacing="18" IsVisible="{Binding !IsRunning}">
        <StackPanel Spacing="8">
          <TextBlock Text="Machine is offline" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" />
          <TextBlock Classes="ui"
                     Text="Start the link, send the invite code to the machine you want in, then let it in. No IP address, no open port - Tailcat sets up the connection." />
        </StackPanel>
        <Button Classes="primary" Content="Start link" HorizontalAlignment="Left" Width="160"
                Click="OnToggleServer" />
      </StackPanel>

      <!-- Link running, no code waiting to be used -->
      <StackPanel Grid.Row="1" Margin="24,26,24,24" Spacing="18" IsVisible="{Binding ShowInvitePrompt}">
        <TextBlock Classes="ui"
                   Text="Invite the machine that should work here. The code lets one machine in for the chosen time, then disappears." />
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Classes="k" Text="access for" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Content="15 min" Tag="15"  Classes.primary="{Binding Dur15}"  Click="OnPickDuration" />
            <Button Content="1 h"    Tag="60"  Classes.primary="{Binding Dur60}"  Click="OnPickDuration" />
            <Button Content="4 h"    Tag="240" Classes.primary="{Binding Dur240}" Click="OnPickDuration" />
            <Button Content="8 h"    Tag="480" Classes.primary="{Binding Dur480}" Click="OnPickDuration" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Invite machine" Width="170" Click="OnInvite" />
          <Button Content="Stop link" Click="OnToggleServer" />
        </StackPanel>
      </StackPanel>

      <!-- Code waiting to be entered on the other side -->
      <StackPanel Grid.Row="1" Margin="24,24,24,22" Spacing="16" IsVisible="{Binding HasInvitation}">
        <StackPanel Spacing="8">
          <TextBlock Classes="k" Text="code for one machine" />
          <SelectableTextBlock Text="{Binding InvitationCode}" FontSize="13.5"
                               Foreground="{DynamicResource Link}" TextWrapping="Wrap" />
          <TextBlock Classes="k" Text="{Binding InvitationHint}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Copy code" Width="140" Click="OnCopy" />
          <Button Content="New code" Click="OnInvite" />
          <Button Content="Stop link" Click="OnToggleServer" />
        </StackPanel>
      </StackPanel>

      <!-- Paired machines -->
      <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="24,16,24,0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
          <TextBlock Grid.Column="0" Classes="k" Text="machines" />
          <TextBlock Grid.Column="2" Classes="k" Text="{Binding MachinesSummary}" />
        </Grid>

        <TextBlock Grid.Row="1" Classes="ui" VerticalAlignment="Top" IsVisible="{Binding HasNoMachines}"
                   Text="Nobody is working on this machine right now. A machine shows up here once it uses an invite code, or when one paired earlier checks back in." />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasMachines}" Padding="0,0,12,0">
          <ItemsControl ItemsSource="{Binding Machines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MachineRow">
                <Grid ColumnDefinitions="2,18,*" Margin="0,0,0,2">
                  <Border Grid.Column="0" Background="{Binding StatusAccent}" CornerRadius="1"
                          Margin="0,10,0,10" />

                  <Grid Grid.Column="2" RowDefinitions="Auto,6,Auto" Margin="0,14,0,14">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                                 Foreground="{Binding StatusAccent}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="val" Text="{Binding DetailText}"
                                 VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <!-- Let in / Extend open a small menu to pick how long -->
                        <Button Classes="primary" Content="Let in" IsVisible="{Binding !HasAccess}">
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="15 min" Tag="15"  Click="OnAdmitFor" />
                              <MenuItem Header="1 h"    Tag="60"  Click="OnAdmitFor" />
                              <MenuItem Header="4 h"    Tag="240" Click="OnAdmitFor" />
                              <MenuItem Header="8 h"    Tag="480" Click="OnAdmitFor" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                        <Button Content="Extend" IsVisible="{Binding HasAccess}">
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="+15 min" Tag="15"  Click="OnExtendFor" />
                              <MenuItem Header="+1 h"    Tag="60"  Click="OnExtendFor" />
                              <MenuItem Header="+4 h"    Tag="240" Click="OnExtendFor" />
                              <MenuItem Header="+8 h"    Tag="480" Click="OnExtendFor" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                        <!-- Cut off is reversible (machine returns as "waiting to be let in"), so it stays neutral -->
                        <Button Content="Cut off" Click="OnRevokeAccess"
                                IsVisible="{Binding HasAccess}" />
                        <!-- Delete is permanent: red, always available -->
                        <Button Classes="danger" Content="Delete" Click="OnDeleteMachine" />
                      </StackPanel>
                    </Grid>
                  </Grid>

                  <Border Grid.Column="2" Classes="sep" VerticalAlignment="Bottom" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Log -->
      <Grid Grid.Row="4" RowDefinitions="Auto,*" Margin="24,16,24,0" Height="160">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Classes="k" Text="log" />
          <TextBlock Grid.Column="2" Classes="k" Text="{Binding Logs.Count}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
          <ItemsControl ItemsSource="{Binding Logs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntry">
                <Grid ColumnDefinitions="Auto,14,44,14,*" Margin="0,0,0,6">
                  <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12"
                             Foreground="{DynamicResource Muted}" />
                  <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="12"
                             HorizontalAlignment="Right" Foreground="{Binding Accent}" />
                  <TextBlock Grid.Column="4" Text="{Binding Message}" FontSize="12"
                             TextWrapping="Wrap" Foreground="{DynamicResource Body}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="5" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
              Padding="24,12" Margin="0,16,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="ui" FontSize="12.5" MaxWidth="520"
                     VerticalAlignment="Center" Text="{Binding Hint}" />
          <Button Grid.Column="1" Classes="danger" Content="Cut off all"
                  IsEnabled="{Binding HasMachines}" Click="OnRevokeEveryone" />
        </Grid>
      </Border>
    </Grid>

    <!-- Lock overlay -->
    <Border Classes="lock" IsVisible="{Binding Lock.IsLocked}">
      <Grid RowDefinitions="*,Auto,*" Margin="24,0">
        <StackPanel Grid.Row="1" Spacing="24" Width="320" HorizontalAlignment="Center">
          <StackPanel Spacing="6">
            <TextBlock Text="avh" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock Classes="k" FontSize="12" Text="{Binding MachineName}" />
          </StackPanel>

          <TextBlock Classes="ui" Text="{Binding Lock.Message}" MaxWidth="320" />

          <StackPanel Spacing="12">
            <StackPanel Spacing="6">
              <TextBlock Classes="k" Text="password" />
              <TextBox Name="PasswordBox" PasswordChar="•" Text="{Binding Lock.Password}"
                       IsEnabled="{Binding Lock.CanSubmit}" KeyDown="OnLockKeyDown" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding Lock.NeedsSetup}">
              <TextBlock Classes="k" Text="repeat password" />
              <TextBox PasswordChar="•" Text="{Binding Lock.Confirmation}" KeyDown="OnLockKeyDown" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <Button Classes="primary" HorizontalAlignment="Stretch" Content="{Binding Lock.ActionText}"
                    IsEnabled="{Binding Lock.CanSubmit}" Click="OnLockSubmit" />
            <TextBlock Classes="k" Height="14" IsVisible="{Binding Lock.HasPenalty}"
                       Foreground="{DynamicResource Warn}"
                       Text="{Binding Lock.PenaltySeconds, StringFormat='next try in {0} s'}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Panel>
</Window>
