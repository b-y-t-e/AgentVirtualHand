<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentVirtualHand.ViewModels"
        x:Class="AgentVirtualHand.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AVH"
        Width="760" Height="680"
        MinWidth="660" MinHeight="540"
        Background="{DynamicResource Bg}"
        FontFamily="Cascadia Mono, Consolas, monospace"
        FontSize="13">

  <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" IsVisible="{Binding Lock.IsUnlocked}">

      <!-- Pasek stanu: czyja to maszyna i kto na niej teraz pracuje -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Height="44" Margin="24,0">
        <TextBlock Grid.Column="0" Text="avh" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="k" FontSize="12" Margin="12,0,0,0"
                   Text="{Binding MachineName}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Lock.LockCountdownText}"
                   IsVisible="{Binding Lock.ShowLockCountdown}" FontSize="12"
                   Foreground="{Binding Lock.LockCountdownAccent}" HorizontalAlignment="Right"
                   Margin="0,0,16,0" VerticalAlignment="Center" />
        <Ellipse Grid.Column="3" Width="6" Height="6" Fill="{Binding StatusAccent}"
                 VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0"
                   Foreground="{Binding StatusAccent}" VerticalAlignment="Center" />
      </Grid>
      <Border Grid.Row="0" Classes="sep" VerticalAlignment="Bottom" />

      <!-- Link zatrzymany -->
      <StackPanel Grid.Row="1" Margin="24,26,24,24" Spacing="18" IsVisible="{Binding !IsRunning}">
        <StackPanel Spacing="8">
          <TextBlock Text="Maszyna jest odcięta" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" />
          <TextBlock Classes="ui"
                     Text="Uruchom link, przekaż kod zaproszenia maszynie, którą chcesz wpuścić, a potem otwórz jej dostęp. Bez adresu IP i bez otwartego portu - połączenie zestawia Tailcat." />
        </StackPanel>
        <Button Classes="primary" Content="Uruchom link" HorizontalAlignment="Left" Width="160"
                Click="OnToggleServer" />
      </StackPanel>

      <!-- Link dziala, zaden kod nie czeka na uzycie -->
      <StackPanel Grid.Row="1" Margin="24,26,24,24" Spacing="18" IsVisible="{Binding ShowInvitePrompt}">
        <TextBlock Classes="ui"
                   Text="Zaproś maszynę, która ma tu pracować. Kod wpuszcza jedną maszynę na czas ustawiony poniżej, a potem znika." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Zaproś maszynę" Width="170" Click="OnInvite" />
          <Button Content="Zatrzymaj link" Click="OnToggleServer" />
        </StackPanel>
      </StackPanel>

      <!-- Kod czeka na wpisanie po drugiej stronie -->
      <StackPanel Grid.Row="1" Margin="24,24,24,22" Spacing="16" IsVisible="{Binding HasInvitation}">
        <StackPanel Spacing="8">
          <TextBlock Classes="k" Text="kod dla jednej maszyny" />
          <SelectableTextBlock Text="{Binding InvitationCode}" FontSize="13.5"
                               Foreground="{DynamicResource Link}" TextWrapping="Wrap" />
          <TextBlock Classes="k" Text="{Binding InvitationHint}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Kopiuj kod" Width="140" Click="OnCopy" />
          <Button Content="Nowy kod" Click="OnInvite" />
          <Button Content="Zatrzymaj link" Click="OnToggleServer" />
        </StackPanel>
      </StackPanel>

      <!-- Sparowane maszyny -->
      <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="24,16,24,0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
          <TextBlock Grid.Column="0" Classes="k" Text="maszyny" />
          <TextBlock Grid.Column="2" Classes="k" Text="{Binding MachinesSummary}" />
        </Grid>

        <TextBlock Grid.Row="1" Classes="ui" VerticalAlignment="Top" IsVisible="{Binding HasNoMachines}"
                   Text="Nikt teraz nie pracuje na tej maszynie. Maszyna pojawi się tutaj, gdy użyje kodu zaproszenia albo gdy wcześniej sparowana zgłosi się ponownie." />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasMachines}">
          <ItemsControl ItemsSource="{Binding Machines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MachineRow">
                <Grid ColumnDefinitions="2,18,*" Margin="0,0,0,2">
                  <Border Grid.Column="0" Background="{Binding StatusAccent}" CornerRadius="1"
                          Margin="0,10,0,10" />

                  <Grid Grid.Column="2" RowDefinitions="Auto,6,Auto" Margin="0,14,0,14">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                                 Foreground="{Binding StatusAccent}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="val" Text="{Binding DetailText}"
                                 VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="primary" Content="Wpuść" Click="OnAdmitMachine"
                                IsVisible="{Binding !HasAccess}" />
                        <Button Content="Przedłuż" Click="OnExtendAccess"
                                IsVisible="{Binding HasAccess}" />
                        <Button Classes="danger" Content="Odetnij" Click="OnRevokeAccess"
                                IsVisible="{Binding HasAccess}" />
                      </StackPanel>
                    </Grid>
                  </Grid>

                  <Border Grid.Column="2" Classes="sep" VerticalAlignment="Bottom" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Jedyny parametr: na jak długo kod wpuszcza maszynę -->
      <StackPanel Grid.Row="4" Margin="24,16,24,10" Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Classes="k" Text="dostęp na" />
          <TextBlock Grid.Column="2" Classes="val" Text="{Binding DurationText}" />
        </Grid>
        <Slider Minimum="5" Maximum="480" TickFrequency="5" IsSnapToTickEnabled="True"
                Value="{Binding DurationMinutes}" />
      </StackPanel>

      <!-- Log -->
      <Grid Grid.Row="5" RowDefinitions="Auto,Auto" Margin="24,8,24,0" MaxHeight="150">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Classes="k" Text="log" />
          <TextBlock Grid.Column="2" Classes="k" Text="{Binding Logs.Count}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Logs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntry">
                <Grid ColumnDefinitions="Auto,14,44,14,*" Margin="0,0,0,6">
                  <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12"
                             Foreground="{DynamicResource Muted}" />
                  <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="12"
                             HorizontalAlignment="Right" Foreground="{Binding Accent}" />
                  <TextBlock Grid.Column="4" Text="{Binding Message}" FontSize="12"
                             TextWrapping="Wrap" Foreground="{DynamicResource Body}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="6" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
              Padding="24,12" Margin="0,16,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="ui" FontSize="12.5" MaxWidth="520"
                     VerticalAlignment="Center" Text="{Binding Hint}" />
          <Button Grid.Column="1" Classes="danger" Content="Odetnij wszystkie"
                  IsEnabled="{Binding HasMachines}" Click="OnRevokeEveryone" />
        </Grid>
      </Border>
    </Grid>

    <!-- Zasłona blokady -->
    <Border Classes="lock" IsVisible="{Binding Lock.IsLocked}">
      <Grid RowDefinitions="*,Auto,*" Margin="24,0">
        <StackPanel Grid.Row="1" Spacing="24" Width="320" HorizontalAlignment="Center">
          <StackPanel Spacing="6">
            <TextBlock Text="avh" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock Classes="k" FontSize="12" Text="{Binding MachineName}" />
          </StackPanel>

          <TextBlock Classes="ui" Text="{Binding Lock.Message}" MaxWidth="320" />

          <StackPanel Spacing="12">
            <StackPanel Spacing="6">
              <TextBlock Classes="k" Text="hasło" />
              <TextBox Name="PasswordBox" PasswordChar="•" Text="{Binding Lock.Password}"
                       IsEnabled="{Binding Lock.CanSubmit}" KeyDown="OnLockKeyDown" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding Lock.NeedsSetup}">
              <TextBlock Classes="k" Text="powtórz hasło" />
              <TextBox PasswordChar="•" Text="{Binding Lock.Confirmation}" KeyDown="OnLockKeyDown" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <Button Classes="primary" HorizontalAlignment="Stretch" Content="{Binding Lock.ActionText}"
                    IsEnabled="{Binding Lock.CanSubmit}" Click="OnLockSubmit" />
            <TextBlock Classes="k" Height="14" IsVisible="{Binding Lock.HasPenalty}"
                       Foreground="{DynamicResource Warn}"
                       Text="{Binding Lock.PenaltySeconds, StringFormat='kolejna próba za {0} s'}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Panel>
</Window>
