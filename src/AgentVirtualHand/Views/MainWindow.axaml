<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentVirtualHand.ViewModels"
        x:Class="AgentVirtualHand.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AgentVirtualHand"
        Width="1020" Height="720"
        MinWidth="900" MinHeight="620"
        Background="{DynamicResource Bg}"
        FontFamily="Inter, Segoe UI, sans-serif">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#1D2431" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#252D3D" />
      <Setter Property="BorderBrush" Value="#33405A" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="#08101F" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#6BA0FF" />
      <Setter Property="Foreground" Value="#08101F" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      <Setter Property="Background" Value="#20161A" />
      <Setter Property="BorderBrush" Value="#3A2229" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2E1A20" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,18">

    <!-- Nagłówek -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,18">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="AgentVirtualHand" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}" />
        <TextBlock Classes="muted" Text="{Binding MachineName, StringFormat='zdalna ręka na {0}'}" />
      </StackPanel>

      <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="999"
              Background="#1D2431" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              Padding="12,6">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="{Binding StatusAccent}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Text}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Tresc -->
    <Grid Grid.Row="1" ColumnDefinitions="360,*" RowDefinitions="*">

      <!-- Lewa kolumna -->
      <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Classes="title" Text="SERWER" />

              <StackPanel>
                <TextBlock Classes="label" Text="Port" />
                <TextBox Text="{Binding Port}" IsEnabled="{Binding !IsRunning}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="label" Text="Dostępny w sieci lokalnej"
                             VerticalAlignment="Center" Margin="0" />
                  <ToggleSwitch Grid.Column="1" OnContent="" OffContent=""
                                IsChecked="{Binding LanVisible}" IsEnabled="{Binding !IsRunning}" />
                </Grid>
                <TextBlock Classes="muted" Text="{Binding VisibilityHint}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="label" Text="Czas dostępu" Margin="0" />
                  <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="12"
                             FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                </Grid>
                <Slider Minimum="5" Maximum="480" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding DurationMinutes}" />
              </StackPanel>

              <Border IsVisible="{Binding IsRunning}" CornerRadius="10" Padding="12,10"
                      Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="Nasłuchuje na" Margin="0" />
                  <SelectableTextBlock Text="{Binding BaseUrl}" FontSize="13"
                                       FontFamily="Consolas, ui-monospace, monospace" Foreground="#A9D3FF" />
                </StackPanel>
              </Border>

              <Button Name="ServerButton" Classes="primary" HorizontalAlignment="Stretch"
                      Content="{Binding ServerButtonText}" Click="OnToggleServer" />

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,10,Auto">
                  <Button Grid.Column="0" HorizontalAlignment="Stretch"
                          Content="Odblokuj port w firewallu" Click="OnOpenFirewall" />
                  <Button Grid.Column="2" Content="Cofnij" Click="OnCloseFirewall" />
                </Grid>
                <TextBlock Classes="muted"
                           Text="Użyj, jeśli klient nie może się połączyć mimo działającego serwera. System poprosi o uprawnienia administratora." />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasSession}">
            <StackPanel Spacing="12">
              <TextBlock Classes="title" Text="AKTYWNA SESJA" />
              <TextBlock Text="{Binding RemainingText}" FontSize="34" FontWeight="Light"
                         FontFamily="Consolas, ui-monospace, monospace"
                         Foreground="#63D19B" />
              <TextBlock Classes="muted" Text="{Binding ClientText}" />
              <Grid ColumnDefinitions="*,10,*">
                <Button Grid.Column="0" Content="Przedłuż" Click="OnExtend" HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Classes="danger" Content="Odetnij dostęp"
                        Click="OnEndSession" HorizontalAlignment="Stretch" />
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- Prawa kolumna -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">

        <Border Grid.Row="0" Classes="card" Margin="0,0,0,16">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="title" Text="PAROWANIE" Margin="0" />
              <Button Grid.Column="1" Classes="primary" Content="Paruj" Width="120"
                      IsEnabled="{Binding CanPair}" Click="OnPair" />
            </Grid>

            <TextBlock Classes="muted" IsVisible="{Binding !HasPairCode}"
                       Text="Kliknij Paruj - aplikacja wygeneruje jednorazowy kod, adres i kod QR. Po udanym parowaniu okno zamyka się automatycznie i nikt inny się nie podłączy." />

            <Grid ColumnDefinitions="Auto,24,*" IsVisible="{Binding HasPairCode}">
              <Border Grid.Column="0" CornerRadius="12" Background="{DynamicResource Bg}"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10">
                <Image Source="{Binding QrImage}" Width="188" Height="188" />
              </Border>

              <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Classes="label" Text="Kod parowania" />
                  <TextBlock Text="{Binding PairCode}" FontSize="30" FontWeight="SemiBold"
                             FontFamily="Consolas, ui-monospace, monospace"
                             Foreground="{DynamicResource Text}" />
                </StackPanel>

                <StackPanel>
                  <TextBlock Classes="label" Text="Adres" />
                  <SelectableTextBlock Text="{Binding ConnectionText}" FontSize="13"
                                       FontFamily="Consolas, ui-monospace, monospace"
                                       Foreground="#A9D3FF" />
                </StackPanel>

                <Grid ColumnDefinitions="*,10,Auto">
                  <Button Grid.Column="0" Classes="primary" HorizontalAlignment="Stretch"
                          Content="Kopiuj dane + instrukcję" Click="OnCopy" />
                  <Button Grid.Column="2" Content="Nowy kod" Click="OnPair" />
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Classes="title" Text="LOG NA ŻYWO" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogEntry">
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,6">
                      <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12"
                                 FontFamily="Consolas, ui-monospace, monospace"
                                 Foreground="#5C6474" Opacity="0.7" />
                      <Border Grid.Column="1" Width="6" Height="6" CornerRadius="3" Margin="10,6,10,0"
                              VerticalAlignment="Top" Background="{Binding Accent}" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12.5"
                                 TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Pasek podpowiedzi -->
    <Border Grid.Row="2" Margin="0,16,0,0" CornerRadius="10" Padding="14,10"
            Background="#12161E" BorderBrush="{DynamicResource Line}" BorderThickness="1">
      <TextBlock Text="{Binding Hint}" Classes="muted" />
    </Border>
  </Grid>
</Window>
