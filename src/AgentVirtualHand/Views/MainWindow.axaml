<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentVirtualHand.ViewModels"
        x:Class="AgentVirtualHand.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AgentVirtualHand"
        Width="720" Height="620"
        MinWidth="640" MinHeight="520"
        Background="{DynamicResource Bg}"
        FontFamily="Cascadia Mono, Consolas, monospace"
        FontSize="13">

  <Window.Styles>
    <!-- Etykieta techniczna: male, wyciszone, monospace -->
    <Style Selector="TextBlock.k">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>

    <Style Selector="TextBlock.val">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Body}" />
    </Style>

    <!-- Proza czytana zdaniami - font interfejsowy, nie monospace -->
    <Style Selector="TextBlock.ui">
      <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource Soft}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.sep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Line}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Field}" />
      <Setter Property="Foreground" Value="#C7CEDA" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C222C" />
      <Setter Property="BorderBrush" Value="#2C3444" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#12161D" />
      <Setter Property="TextBlock.Foreground" Value="#454D5C" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="#08101F" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#6BA0FF" />
      <Setter Property="TextBlock.Foreground" Value="#08101F" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerLine}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1B1216" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Danger}" />
    </Style>

    <!-- Pole portu: bez pudelka, sama linia pod wartoscia -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Body}" />
      <Setter Property="Padding" Value="0,0,0,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBox:disabled">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="ToggleSwitch">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="Foreground" Value="{DynamicResource Body}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Link}" />
      <Setter Property="Padding" Value="0,0,6,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Slider">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,-4" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">

    <!-- 1. Pasek stanu -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Height="42" Margin="22,0">
      <TextBlock Grid.Column="0" Text="agentvirtualhand" FontSize="12.5" FontWeight="SemiBold"
                 Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="k" FontSize="12" Margin="12,0,0,0"
                 Text="{Binding MachineName}" VerticalAlignment="Center" />
      <Ellipse Grid.Column="3" Width="6" Height="6" Fill="{Binding StatusAccent}"
               VerticalAlignment="Center" />
      <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0"
                 Foreground="{Binding StatusAccent}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="5" Classes="k" FontSize="12" Margin="10,0,0,0"
                 Text="{Binding RemainingText}" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="0" Classes="sep" VerticalAlignment="Bottom" />

    <!-- 2a. Serwer zatrzymany -->
    <StackPanel Grid.Row="1" Margin="22,24,22,22" Spacing="16" IsVisible="{Binding !IsRunning}">
      <StackPanel Spacing="7">
        <TextBlock Classes="k" Text="maszyna odcięta" />
        <TextBlock Classes="ui" MaxWidth="520" HorizontalAlignment="Left"
                   Text="Uruchom link, przekaż kod zaproszenia drugiej maszynie, potem otwórz dostęp. Bez adresu IP i bez otwartego portu - połączenie zestawia Tailcat." />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*">
        <Button Grid.Column="0" Classes="primary" Content="Uruchom link" Click="OnToggleServer" />
      </Grid>
    </StackPanel>

    <!-- 2b. Serwer dziala, brak kodu -->
    <StackPanel Grid.Row="1" Margin="22,24,22,22" Spacing="16" IsVisible="{Binding ShowPairPrompt}">
      <StackPanel Spacing="5">
        <TextBlock Classes="k" Text="kod zaproszenia" />
        <SelectableTextBlock Text="{Binding InvitationCode}" FontSize="15"
                             Foreground="{DynamicResource Link}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Classes="ui" MaxWidth="520" HorizontalAlignment="Left"
                 Text="Na drugiej maszynie: avh-link join &lt;kod&gt;. Kod jest jednorazowy - potem klient wraca bez niego. Dostęp otwierasz osobno i wygasa sam." />
      <Grid ColumnDefinitions="Auto,8,Auto,8,Auto,8,*">
        <Button Grid.Column="0" Classes="primary" Content="Otwórz dostęp" Width="140"
                IsEnabled="{Binding CanPair}" Click="OnOpenAccess" />
        <Button Grid.Column="2" Content="Nowy kod" Click="OnNewInvitation" />
        <Button Grid.Column="4" Content="Odepnij maszynę" Click="OnResetPeer" />
        <Button Grid.Column="6" Content="Zatrzymaj link" Click="OnToggleServer"
                HorizontalAlignment="Left" />
      </Grid>
    </StackPanel>

    <!-- 2c. Kod parowania + QR -->
    <Grid Grid.Row="1" Margin="22,22,22,20" ColumnDefinitions="132,22,*"
          IsVisible="{Binding HasSession}">
      <Border Grid.Column="0" Width="132" Height="132" CornerRadius="4" Padding="9"
              VerticalAlignment="Top" Background="White">
        <Image Source="{Binding QrImage}" />
      </Border>

      <StackPanel Grid.Column="2" Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock Classes="k" Text="kod zaproszenia" />
          <SelectableTextBlock Text="{Binding InvitationCode}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
          <TextBlock Classes="k" FontSize="11.5" Text="avh-link join &lt;kod&gt; - jednorazowy, ważny 15 minut" />
        </StackPanel>
        <StackPanel Spacing="5">
          <TextBlock Classes="k" Text="druga maszyna" />
          <TextBlock Classes="val" Text="{Binding PeerText}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,8,Auto">
          <Button Grid.Column="0" Classes="primary" HorizontalAlignment="Stretch"
                  Content="Kopiuj instrukcję" Click="OnCopy" />
          <Button Grid.Column="2" Content="Nowy kod" Click="OnNewInvitation" />
        </Grid>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Classes="sep" VerticalAlignment="Bottom" />

    <!-- 3. Ustawienia jako gesta siatka -->
    <Grid Grid.Row="2" Margin="22,16" ColumnDefinitions="*,34,*" RowDefinitions="Auto,10,Auto">
      <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Classes="k" Text="port lokalny" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Port}" IsEnabled="{Binding !IsRunning}"
                 VerticalAlignment="Center" />
      </Grid>
      <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Classes="k" Text="klient" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="val" Text="{Binding ClientText}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </Grid>

      <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Classes="k" Text="link" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="val" Text="{Binding PeerText}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
      <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Classes="k" Text="okno dostępu" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="val" Text="{Binding DurationText}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>

    </Grid>
    <Border Grid.Row="2" Classes="sep" VerticalAlignment="Bottom" />

    <!-- 4. Suwak okna dostepu - ustawiany przed startem -->
    <StackPanel Grid.Row="3" Margin="22,14,22,14" Spacing="6" IsVisible="{Binding !IsRunning}">
      <Slider Minimum="5" Maximum="480" TickFrequency="5" IsSnapToTickEnabled="True"
              Value="{Binding DurationMinutes}" />
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="k" Text="5 min" />
        <TextBlock Grid.Column="2" Classes="k" Text="8 h" />
      </Grid>
    </StackPanel>

    <!-- 5. Aktywna sesja -->
    <Grid Grid.Row="4" Margin="22,14" ColumnDefinitions="Auto,*,Auto,8,Auto"
          IsVisible="{Binding HasSession}">
      <TextBlock Grid.Column="0" Classes="k" Text="sesja" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="val" Margin="12,0,0,0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Ok}" Text="{Binding RemainingText}" />
      <Button Grid.Column="2" Content="Przedłuż" Click="OnExtend" />
      <Button Grid.Column="4" Classes="danger" Content="Odetnij dostęp" Click="OnEndSession" />
    </Grid>

    <!-- 6. Log -->
    <Grid Grid.Row="5" RowDefinitions="Auto,*" Margin="22,14,22,0">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
        <TextBlock Grid.Column="0" Classes="k" Text="log" />
        <TextBlock Grid.Column="2" Classes="k" Text="{Binding Logs.Count}" />
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Logs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LogEntry">
              <Grid ColumnDefinitions="Auto,12,42,12,*" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12"
                           Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="12"
                           HorizontalAlignment="Right" Foreground="{Binding Accent}" />
                <TextBlock Grid.Column="4" Text="{Binding Message}" FontSize="12"
                           TextWrapping="Wrap" Foreground="{DynamicResource Body}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- 7. Podpowiedz -->
    <TextBlock Grid.Row="6" Classes="ui" FontSize="12.5" Margin="22,14,22,14"
               Text="{Binding Hint}" />

    <!-- 8. Skroty -->
    <Border Grid.Row="7" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
            Padding="22,11">
      <StackPanel Orientation="Horizontal" Spacing="20">
        <TextBlock Classes="k" FontSize="11.5">
          <Run Text="^S" /><Run Text=" " /><Run Text="{Binding ServerButtonText}"
                                               Foreground="{DynamicResource Soft}" />
        </TextBlock>
        <TextBlock Classes="k" FontSize="11.5">
          <Run Text="^P" /><Run Text=" " /><Run Text="otwórz dostęp" Foreground="{DynamicResource Soft}" />
        </TextBlock>
        <TextBlock Classes="k" FontSize="11.5">
          <Run Text="^D" /><Run Text=" " /><Run Text="kopiuj" Foreground="{DynamicResource Soft}" />
        </TextBlock>
        <TextBlock Classes="k" FontSize="11.5">
          <Run Text="^N" /><Run Text=" " /><Run Text="nowy kod" Foreground="{DynamicResource Soft}" />
        </TextBlock>
      </StackPanel>
    </Border>
  </Grid>
</Window>
