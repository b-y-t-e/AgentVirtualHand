<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>avh-hub</AssemblyName>
    <RootNamespace>AgentVirtualHand.Hub</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Tailcat.Link" Version="0.4.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Koperta protokolu jest wspolna z hostem - jeden plik, zeby strony nie rozjechaly sie w locie. -->
    <Compile Include="..\AgentVirtualHand\Server\LinkProtocol.cs" Link="LinkProtocol.cs" />
    <!-- Query koperty dekodujemy tak samo jak host (i binding ASP.NET). -->
    <Compile Include="..\AgentVirtualHand\Server\LinkQuery.cs" Link="LinkQuery.cs" />
    <!-- Log huba dekoduje skrypt tak samo jak host. -->
    <Compile Include="..\AgentVirtualHand\Server\ExecScript.cs" Link="ExecScript.cs" />
    <Compile Include="..\AgentVirtualHand\Server\BomText.cs" Link="BomText.cs" />
    <!-- Prompt podaje te same limity exec, ktore wymusza host. -->
    <Compile Include="..\AgentVirtualHand\Server\ExecLimits.cs" Link="ExecLimits.cs" />
    <!-- Postep transferow logujemy tym samym progiem i formatem co host. -->
    <Compile Include="..\AgentVirtualHand\Server\TransferProgressLog.cs" Link="TransferProgressLog.cs" />
    <!-- Blokada okna jest wspolna dla obu aplikacji okienkowych. -->
    <Compile Include="..\AgentVirtualHand\Services\PasswordGate.cs" Link="PasswordGate.cs" />
    <Compile Include="..\AgentVirtualHand\ViewModels\LockViewModel.cs" Link="LockViewModel.cs" />
    <Compile Include="..\AgentVirtualHand\Services\AppPaths.cs" Link="AppPaths.cs" />
    <Compile Include="..\AgentVirtualHand\Services\SingleInstance.cs" Link="SingleInstance.cs" />
    <AvaloniaResource Include="..\AgentVirtualHand\Styles\Theme.axaml" Link="Styles\Theme.axaml" />
  </ItemGroup>

</Project>
