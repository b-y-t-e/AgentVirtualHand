<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>avh-hub</AssemblyName>
    <RootNamespace>AgentVirtualHand.Hub</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Tailcat.Link" Version="0.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Koperta protokolu jest wspolna z hostem - jeden plik, zeby strony nie rozjechaly sie w locie. -->
    <Compile Include="..\AgentVirtualHand\Server\LinkProtocol.cs" Link="LinkProtocol.cs" />
    <!-- Blokada okna jest wspolna dla obu aplikacji okienkowych. -->
    <Compile Include="..\AgentVirtualHand\Services\PasswordGate.cs" Link="PasswordGate.cs" />
    <Compile Include="..\AgentVirtualHand\ViewModels\LockViewModel.cs" Link="LockViewModel.cs" />
    <Compile Include="..\AgentVirtualHand\Services\AppPaths.cs" Link="AppPaths.cs" />
    <AvaloniaResource Include="..\AgentVirtualHand\Styles\Theme.axaml" Link="Styles\Theme.axaml" />
  </ItemGroup>

</Project>
