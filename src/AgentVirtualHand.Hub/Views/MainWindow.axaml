<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentVirtualHand.Hub.ViewModels"
        x:Class="AgentVirtualHand.Hub.Views.MainWindow"
        x:DataType="vm:HubViewModel"
        Title="AVH Hub"
        Width="760" Height="660"
        MinWidth="660" MinHeight="520"
        Background="{DynamicResource Bg}"
        FontFamily="Cascadia Mono, Consolas, monospace"
        FontSize="13">

  <Panel>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" IsVisible="{Binding Lock.IsUnlocked}">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="44" Margin="24,0">
        <TextBlock Grid.Column="0" Text="avh hub" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Lock.LockCountdownText}"
                   IsVisible="{Binding Lock.ShowLockCountdown}" FontSize="12"
                   Foreground="{Binding Lock.LockCountdownAccent}" HorizontalAlignment="Right"
                   Margin="0,0,16,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="k" FontSize="12" VerticalAlignment="Center"
                   Text="{Binding ConnectionsSummary}" />
      </Grid>
      <Border Grid.Row="0" Classes="sep" VerticalAlignment="Bottom" />

      <!-- Dodanie maszyny: nazwa jest dla Ciebie, kod pochodzi z jej okna -->
      <Grid Grid.Row="1" Margin="24,20,24,18" ColumnDefinitions="170,16,*,16,Auto">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Classes="k" Text="name" />
          <TextBox Text="{Binding NewName}" Watermark="labsvcn" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Classes="k" Text="invite code from that machine's window" />
          <TextBox Text="{Binding NewCode}" Watermark="tc..." />
        </StackPanel>
        <Button Grid.Column="4" Classes="primary" Content="Add computer"
                VerticalAlignment="Bottom" Click="OnAdd" />
      </Grid>
      <Border Grid.Row="1" Classes="sep" VerticalAlignment="Bottom" />

      <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="24,18,24,0">
        <TextBlock Grid.Row="0" Classes="k" Text="computers" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Classes="ui" VerticalAlignment="Top" IsVisible="{Binding HasNoConnections}"
                   Text="No computers yet. On the machine you want to control, start the link and paste its invite code here. Each computer gets its own address and token, so a prompt made for one does not reach the others." />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasConnections}">
          <ItemsControl ItemsSource="{Binding Connections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConnectionRow">
                <!-- List row, not a card: the vertical bar on the left edge carries the status -->
                <Grid ColumnDefinitions="2,18,*" Margin="0,0,0,2">
                  <Border Grid.Column="0" Background="{Binding StatusAccent}" CornerRadius="1"
                          Margin="0,10,0,10" />

                  <Grid Grid.Column="2" RowDefinitions="Auto,6,Auto" Margin="0,14,0,14">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                                 Foreground="{Binding StatusAccent}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                      <SelectableTextBlock Grid.Column="0" Text="{Binding AddressText}" FontSize="12"
                                           Foreground="{DynamicResource Link}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="primary" Content="Copy prompt" Click="OnCopyPrompt"
                                IsEnabled="{Binding IsOpen}" />
                        <Button Classes="quiet" Content="{Binding ToggleText}" Click="OnToggle"
                                IsEnabled="{Binding NotBusy}" />
                        <!-- Rzadkie akcje pod menu: zajmowaly tyle samo miejsca co te uzywane stale -->
                        <Button Classes="quiet" Content="⋯" Width="34" ToolTip.Tip="More">
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="New token" Click="OnRotateToken"
                                        IsEnabled="{Binding IsOpen}" />
                              <MenuItem Header="Remove computer" Click="OnRemove" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Grid>

                  <Border Grid.Column="2" Classes="sep" VerticalAlignment="Bottom" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="24,18,24,0" Height="170">
        <TextBlock Grid.Row="0" Classes="k" Text="log" Margin="0,0,0,10" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Logs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntry">
                <Grid ColumnDefinitions="Auto,14,44,14,*" Margin="0,0,0,6">
                  <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12"
                             Foreground="{DynamicResource Muted}" />
                  <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="12"
                             HorizontalAlignment="Right" Foreground="{Binding Accent}" />
                  <TextBlock Grid.Column="4" Text="{Binding Message}" FontSize="12"
                             TextWrapping="Wrap" Foreground="{DynamicResource Body}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
              Padding="24,14" Margin="0,18,0,0">
        <TextBlock Classes="ui" FontSize="12.5" MaxWidth="660" HorizontalAlignment="Left"
                   Text="{Binding Hint}" />
      </Border>
    </Grid>

    <!-- Lock overlay: the hub holds tokens to other machines -->
    <Border Classes="lock" IsVisible="{Binding Lock.IsLocked}">
      <Grid RowDefinitions="*,Auto,*" Margin="24,0">
        <StackPanel Grid.Row="1" Spacing="24" Width="320" HorizontalAlignment="Center">
          <TextBlock Text="avh hub" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" />

          <TextBlock Classes="ui" Text="{Binding Lock.Message}" MaxWidth="320" />

          <StackPanel Spacing="12">
            <StackPanel Spacing="6">
              <TextBlock Classes="k" Text="password" />
              <TextBox Name="PasswordBox" PasswordChar="•" Text="{Binding Lock.Password}"
                       IsEnabled="{Binding Lock.CanSubmit}" KeyDown="OnLockKeyDown" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding Lock.NeedsSetup}">
              <TextBlock Classes="k" Text="repeat password" />
              <TextBox PasswordChar="•" Text="{Binding Lock.Confirmation}" KeyDown="OnLockKeyDown" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <Button Classes="primary" HorizontalAlignment="Stretch" Content="{Binding Lock.ActionText}"
                    IsEnabled="{Binding Lock.CanSubmit}" Click="OnLockSubmit" />
            <TextBlock Classes="k" Height="14" IsVisible="{Binding Lock.HasPenalty}"
                       Foreground="{DynamicResource Warn}"
                       Text="{Binding Lock.PenaltySeconds, StringFormat='next try in {0} s'}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Panel>
</Window>
